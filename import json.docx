		<div id="m_textViewLayer" class="layer" style="z-index: 2; visibility: visible;">
			<div id="m_content" style="font-size: 100%; overflow-y: auto; direction: ltr; right: 20px;"><div><div id="m_topBuffer" style="height: 200px; display: none;"><img src="https://res.public.onecdn.static.microsoft/officeonline/hashed/79b48a07e8b20228/spiral.gif" class="loading" style="top: calc(50% + 20px);"></div><div id="pc1"><div style="height: 0px;"></div><div class="pageNumV2">1 / 9</div><div id="p1" name="p1"><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">import json <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">import os <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">import sys <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">from tinyfish import TinyFish, RunStatus <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"># ========================================== <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"># SMARTBUY AI - PRODUCT PRICE RESEARCH AGENT <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"># ========================================== <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">PRODUCT_NAME = "Samsung Galaxy S25" <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">PRODUCT_URL = ( <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;"https://www.91mobiles.com/" <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;"samsung-galaxy-s25-price-in-india" <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"># STEP 1: Check API key <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">api_key = os.getenv("TINYFISH_API_KEY") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">if not api_key: <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;print("ERROR: TinyFish API key is missing.") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;print("Set your TINYFISH_API_KEY and try again.") <br></span></div></div><hr class="pageHrV2"></div><div id="pc2"><div class="pageNumV2">2 / 9</div><div id="p2" name="p2"><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;sys.exit(1) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"># STEP 2: Connect to TinyFish <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">print("\n================================") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">print(" &nbsp; &nbsp; &nbsp; SMARTBUY AI") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">print("================================") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">print("\nConnecting to TinyFish...") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">try: <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;client = TinyFish() <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;print("TinyFish connected successfully!") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">except Exception as error: <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;print("Connection failed:", error) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;sys.exit(1) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"># STEP 3: Define extraction instructions <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">goal = """ <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">You are SmartBuy AI, a shopping research agent. <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">Visit this product research page: <br></span></div></div><hr class="pageHrV2"></div><div id="pc3"><div class="pageNumV2">3 / 9</div><div id="p3" name="p3"><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">Find the section titled: <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">Samsung Galaxy S25 Price In India <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">Extract the price comparison table. <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">Return all available offers. <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">For each offer extract: <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">1. Product name <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">2. Storage variant <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">3. Store name <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">4. Listed price in INR <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">IMPORTANT RULES: <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">- Focus on Samsung Galaxy S25. <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">- Extract the 256 GB variant separately. <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">- Do not mix prices from different variants. <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">- Extract only prices actually shown on the page. <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">- Do not invent or estimate prices. <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">- Do not confuse ratings with prices. <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">- If a value is missing, write Not available. <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">""" <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div></div><hr class="pageHrV2"></div><div id="pc4"><div class="pageNumV2">4 / 9</div><div id="p4" name="p4"><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"># STEP 4: Define structured output <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">output_schema = { <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;"type": "object", <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;"properties": { <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;"product_name": { <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"type": "string" <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;}, <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;"offers": { <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"type": "array", <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"items": { <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"type": "object", <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"properties": { <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"variant": { <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"type": "string" <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;}, <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"store": { <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"type": "string" <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;}, <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"price": { <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"type": "string" <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;} <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;}, <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"required": [ <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"variant", <br></span></div></div><hr class="pageHrV2"></div><div id="pc5"><div class="pageNumV2">5 / 9</div><div id="p5" name="p5"><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"store", <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"price" <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;] <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;} <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;} <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;}, <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;"required": [ <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;"product_name", <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;"offers" <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;] <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">} <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"># STEP 5: Run TinyFish Agent <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">print("\nProduct:", PRODUCT_NAME) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">print("\nStarting product research...") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">print("Please wait while TinyFish processes the page.\n") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">try: <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;response = client.agent.run( <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;url=PRODUCT_URL, <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;goal=goal, <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;output_schema=output_schema <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;) <br></span></div></div><hr class="pageHrV2"></div><div id="pc6"><div class="pageNumV2">6 / 9</div><div id="p6" name="p6"><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;# STEP 6: Process results <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;if response.status == RunStatus.COMPLETED: <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;data = response.result <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;if isinstance(data, str): <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;data = json.loads(data) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;print("\n================================") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;print(" &nbsp; &nbsp; &nbsp; PRODUCT RESEARCH") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;print("================================") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;print("\nProduct:", data.get("product_name", PRODUCT_NAME)) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;offers = data.get("offers", []) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;if not offers: <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;print("\nNo store offers were extracted.") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;else: <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;valid_offers = [] <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;for offer in offers: <br></span></div></div><hr class="pageHrV2"></div><div id="pc7"><div class="pageNumV2">7 / 9</div><div id="p7" name="p7"><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;print("\n--------------------------------") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;print("Store:", offer.get("store")) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;print("Variant:", offer.get("variant")) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;print("Price:", offer.get("price")) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;# Extract numerical price safely <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;price_text = offer.get("price", "") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;digits = "".join( <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;character <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;for character in price_text <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;if character.isdigit() <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;if ( <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;digits <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;and offer.get("variant", "").strip() <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;== "256 GB" <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;): <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;valid_offers.append({ <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"store": offer.get("store"), <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"price": int(digits), <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"variant": offer.get("variant") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;}) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div></div><hr class="pageHrV2"></div><div id="pc8"><div class="pageNumV2">8 / 9</div><div id="p8" name="p8"><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;# STEP 7: Find lowest listed price <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;if valid_offers: <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;valid_offers.sort( <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;key=lambda item: item["price"] <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;best = valid_offers[0] <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;print("\n================================") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;print(" &nbsp; &nbsp; &nbsp; &nbsp; BEST LISTED DEAL") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;print("================================") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;print("Store:", best["store"]) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;print("Price: Rs.", best["price"]) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;print("Variant:", best["variant"]) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;else: <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;print("\nNo valid 256 GB prices found.") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;# STEP 8: Save research output <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;with open( <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"shopping_results.json", <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;"w", <br></span></div></div><hr class="pageHrV2"></div><div id="pc9"><div class="pageNumV2">9 / 9</div><div id="p9" name="p9"><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;encoding="utf-8" <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;) as file: <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;json.dump( <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;data, <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;file, <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;indent=4, <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;ensure_ascii=False <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;print("\nResults saved to shopping_results.json") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;else: <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;print("\nTinyFish execution was not completed.") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;print("Status:", response.status) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp; &nbsp; &nbsp;print("Error:", response.error) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">except Exception as error: <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;print("\nAn error occurred:") <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp; &nbsp;print(type(error).__name__, error) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">print("\nSmartBuy AI research finished!") <br></span></div></div><hr class="pageHrV2"></div><div id="m_endBuffer" style="height: 200px; display: none;"><img src="https://res.public.onecdn.static.microsoft/officeonline/hashed/79b48a07e8b20228/spiral.gif" class="loading"></div></div></div>
